{
  "name": "rstack-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "bump": "bumpp",
    "fmt": "rs fmt",
    "fmt:check": "rs fmt --check",
    "lint": "rs lint --type-check",
    "package": "pnpm -r run package",
