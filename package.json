    "test:e2e": "pnpm -r run test:e2e",
    "test:unit": "pnpm -r run test:unit"
  },
  "devDependencies": {
    "bumpp": "^12.2.1",
    "rstack": "^0.3.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  }
}
